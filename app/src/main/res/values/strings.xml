    <!-- 시작하기 -->
    <string name="setup_optional">권장</string>
    <string name="setup_done">완료</string>
    <string name="setup_pending">해야 할 일</string>
    <string name="setup_notification_title">알림 접근 허용</string>
    <string name="setup_notification_body">어떤 앱에서 알림이 왔는지만 확인해요. 알림 내용은 읽거나 저장하지 않아요.</string>
    <string name="setup_accessibility_title">접근성 서비스 켜기</string>
    <string name="setup_accessibility_body">화면을 전원 버튼처럼 켜는 데만 써요. 화면 내용은 읽지 않아요. 접근성 설정의 ‘설치된 앱’(또는 ‘다운로드한 앱’)에서 ‘똑똑 화면 켜기’를 켜 주세요.</string>
    <string name="setup_accessibility_body_optional">기본 방식은 접근성 없이도 켜지지만, 삼성 폰은 접근성이 있어야 화면이 켜질 수 있어요. 화면 자동 끄기에도 필요해요. 화면 내용은 읽지 않아요.</string>
    <string name="setup_restricted_title">허용 버튼이 눌리지 않나요?</string>
    <string name="setup_restricted_hint">직접 설치한 앱은 처음에 막혀 있어요. 앱 정보에서 오른쪽 위 ⋮ 를 누르고 ‘제한된 설정 허용’을 선택한 뒤 다시 켜 주세요.</string>
    <string name="setup_open_app_info">앱 정보 열기</string>
    <string name="setup_battery_title">배터리 사용 제한 없음</string>
    <string name="setup_battery_body">절전 기능 때문에 알림 감지가 끊기지 않게 해요.</string>
    <string name="setup_status_notifications_title">문제가 생기면 알림 받기</string>
    <string name="setup_status_notifications_body">접근성 서비스가 멈추는 등 화면 켜기가 제대로 안 될 때만 알려 드려요.</string>
    <string name="setup_test_title">화면 켜기 테스트</string>
    <string name="setup_test_body">이 폰에서 화면이 켜지자마자 얼굴 인식이 되는지 확인해요.</string>
    <string name="setup_action_allow">허용하기</string>
