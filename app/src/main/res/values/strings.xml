    <!-- 화면 켜는 방식 -->
    <string name="method_screen_title">화면 켜는 방식</string>
    <string name="method_recommended">추천</string>
    <string name="method_menu_key_title">전원 버튼 방식</string>
    <string name="method_menu_key_body">폰이 ‘버튼을 눌러 켰다’고 인식해서 얼굴 인식이 바로 시작돼요. 접근성 서비스가 필요해요.</string>
    <string name="method_menu_key_unsupported">Android 16 이상에서만 쓸 수 있어요.</string>
    <string name="method_wake_lock_title">기본 방식</string>
    <string name="method_wake_lock_body">대부분의 폰에서 화면이 켜지지만, 얼굴 인식은 바로 시작되지 않아요.</string>
    <string name="method_fallback_title">안 켜지면 기본 방식으로 다시 켜기</string>
    <string name="method_fallback_body">전원 버튼 방식으로 화면이 켜지지 않을 때 기본 방식으로 한 번 더 켜요.</string>
    <string name="method_avoid_dozing_title">AOD가 떠 있을 때는 기본 방식으로 켜기</string>
    <string name="method_avoid_dozing_body">AOD 상태에서 알림이 올 때 PIN 입력 화면이 뜬다면 켜 주세요. 이때는 얼굴 인식이 바로 시작되지 않아요.</string>
    <string name="method_tip_title">얼굴 인식 후 바로 홈 화면으로 넘어간다면</string>
    <string name="method_tip_body">삼성 얼굴 인식 설정에서 인식한 뒤에도 잠금화면에 머무르는 옵션(영문명 Stay on Lock screen)을 켜 보세요. 아이폰처럼 잠금화면에서 알림을 보고, 밀어 올려서 들어가게 돼요.</string>
    <string name="method_tip_action">보안 설정 열기</string>
    <string name="result_untested">테스트 전</string>
    <string name="result_face_unlock">얼굴 인식 확인됨</string>
    <string name="result_screen_only">얼굴 인식 안 됨</string>
    <string name="result_no_wake">화면 안 켜짐</string>
    <string name="result_pin_screen">PIN 화면이 뜸</string>

    <!-- 테스트 -->
    <string name="test_section_title">화면 켜기 테스트</string>
    <string name="test_idle_body">%1$s으로 실제로 화면을 켜 보고 얼굴 인식이 되는지 확인해요. AOD를 쓴다면 켠 상태와 끈 상태에서 각각 해 보세요.</string>
    <string name="test_needs_accessibility">전원 버튼 방식을 테스트하려면 먼저 접근성 서비스를 켜 주세요.</string>
    <string name="test_start">테스트 시작</string>
    <string name="test_waiting">측면 버튼을 눌러 화면을 꺼 주세요. %1$d초 뒤에 화면이 켜져요. 폰을 얼굴 앞에 가만히 들고 기다려 주세요.</string>
    <string name="test_counting">곧 화면이 켜져요.</string>
    <string name="test_observing">화면이 켜졌어요. 지문은 쓰지 말고 얼굴 인식이 되는지, PIN 입력 화면이 뜨는지 봐 주세요.</string>
    <string name="test_interrupted">기다리는 동안 화면이 먼저 켜졌어요. 다시 해 주세요.</string>
    <string name="test_retry">다시 테스트</string>
