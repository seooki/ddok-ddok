    <string name="duration_minutes">%1$d분</string>
    <string name="cond_quiet_section">방해하지 않을 시간</string>
    <string name="cond_quiet_title">이 시간에는 켜지 않기</string>
    <string name="cond_quiet_body">알림이 와도 화면을 켜지 않아요. 알림 소리는 폰 설정을 따라요.</string>
    <string name="cond_quiet_start">시작</string>
    <string name="cond_quiet_end">끝</string>
