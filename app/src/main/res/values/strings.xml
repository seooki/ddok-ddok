    <string name="test_answer_pin_screen">PIN 입력 화면이 떴어요</string>
    <string name="test_answer_no_wake">화면이 안 켜졌어요</string>
    <string name="test_follow_up_confirmed">얼굴 인식이 확인돼서 이 방식으로 켜요.</string>
    <string name="test_follow_up_switched">이 폰에서는 전원 버튼 방식을 쓸 수 없어서 기본 방식으로 바꿨어요.</string>
    <string name="test_follow_up_avoid_dozing">AOD가 떠 있을 때는 기본 방식으로 켜도록 바꿨어요. 화면이 완전히 꺼져 있을 때는 계속 전원 버튼 방식을 써요.</string>

    <!-- 알림 조건 -->
    <string name="conditions_title">알림 조건</string>
    <string name="cond_dnd_title">방해 금지 모드 따르기</string>
    <string name="cond_dnd_body">방해 금지 모드에서 막힌 알림에는 화면을 켜지 않아요.</string>
    <string name="cond_face_down_title">엎어 두면 켜지 않기</string>
    <string name="cond_face_down_body">화면이 바닥을 향해 있으면 켜지 않아요.</string>
    <string name="cond_pocket_title">주머니·가방 속에서 켜지 않기</string>
    <string name="cond_pocket_body">근접 센서와, 어두운데 세워져 있는지를 함께 봐요. 폰에 따라 정확하지 않을 수 있어요.</string>
    <string name="cond_pocket_unavailable">이 폰에는 주머니 감지에 쓸 센서가 없어요.</string>
    <string name="cond_cooldown_title">다시 켜기까지 간격</string>
    <string name="cond_cooldown_body">알림이 연달아 와도 이 시간 안에는 한 번만 켜요.</string>
    <string name="cond_cooldown_none">없음</string>
    <string name="cond_app_cooldown_title">같은 앱 알림 간격</string>
    <string name="cond_app_cooldown_body">단톡방처럼 몰아서 오는 알림은 같은 앱이면 이 시간 안에 한 번만 켜요.</string>
    <string name="cond_after_wake_section">켜진 뒤</string>
    <string name="cond_auto_off_title">켜진 화면 자동으로 끄기</string>
    <string name="cond_auto_off_body">알림으로 켠 화면을 이 시간이 지나면 전원 버튼처럼 꺼요. 얼굴이나 지문으로 인식되면 끄지 않지만, 인식 없이 잠금화면을 보고 있으면 꺼질 수 있어요. 없음이면 전원 버튼으로 켰을 때처럼 폰 설정을 따라요.</string>
    <string name="cond_auto_off_unavailable">접근성 서비스가 켜져 있어야 쓸 수 있어요.</string>
    <string name="cond_auto_off_none">없음</string>
